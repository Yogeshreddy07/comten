# Backend local development. Never commit real .env files.
ENVIRONMENT=local
PROJECT_ID=demo-crompton-pms
FIREBASE_API_KEY=demo-key
FIRESTORE_EMULATOR_HOST=127.0.0.1:8086
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
WEB_ORIGIN=http://127.0.0.1:3000
ALLOW_REAL_MESSAGES=false
# All three gates are required for SMS/email: global switch, channel switch,
# and exact comma-separated approved recipients (no wildcards). Default stays off.
MSG91_DISPATCH_ENABLED=false
APPROVED_SMS_RECIPIENTS=
ZEPTOMAIL_DISPATCH_ENABLED=false
APPROVED_EMAIL_RECIPIENTS=
FCM_DISPATCH_ENABLED=false
APPROVED_FCM_USER_IDS=
# Deployment: ENVIRONMENT=development, PROJECT_ID=crompton-pms-dev-20261015
# Remove both emulator environment variables and provide ADC/GOOGLE_APPLICATION_CREDENTIALS.
# Railway alternative: paste the entire private service-account JSON as one
# secret variable (never commit the value, and do not set a Windows file path).
FIREBASE_SERVICE_ACCOUNT_JSON=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
RECOVERY_HMAC_KEY=
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
ZEPTOMAIL_TOKEN=
# ZEPTOMAIL_API_KEY is also accepted from env files (legacy name).
# The token may be bare or include the dashboard's Zoho-enczapikey prefix.
ZEPTOMAIL_FROM=
ZEPTOMAIL_VERIFIED_DOMAIN=
# Select the account's regional origin; legacy api.zeptomail.* is also supported.
ZEPTOMAIL_API_ORIGIN=https://cpaas.zoho.in
# Files load in order: root .env, root .env.local, backend .env,
# backend .env.local, then the provider file selected by process ENVIRONMENT.
# Empty provider placeholders never erase existing values; process env wins.
# Optional ignored provider file automatically selected by ENVIRONMENT:
# .local/providers.local.env, .local/providers.development.env, or
# .local/providers.production.env. Never use production credentials in development.
